---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EntryList from '../components/EntryList.astro';
import { PORTFOLIO_TITLE, PORTFOLIO_DESCRIPTION, TECH_STACK, GITHUB_URL } from '../consts';
import { getProjects, getDevlogs, getPosts, blogUrl } from '../lib/posts';

const projects = await getProjects();
const devlogs = await getDevlogs();
const posts = await getPosts();
const projectTitles = Object.fromEntries(projects.map((p) => [p.id, p.data.title]));
---
<BaseLayout section="portfolio">
  <section class="hero">
    <h1>{PORTFOLIO_TITLE}</h1>
    <p>{PORTFOLIO_DESCRIPTION}</p>
    <div class="stack">{TECH_STACK.map((t) => <span class="chip static">{t}</span>)}</div>
    <div class="cta">
      <a class="btn primary" href={blogUrl()}>기술 블로그</a>
      {GITHUB_URL && <a class="btn" href={GITHUB_URL}>GitHub</a>}
    </div>
  </section>

  <div class="section-title">프로젝트 {projects.length}</div>
  <div class="project-grid">{projects.map((p) => <ProjectCard project={p} />)}</div>

  {(devlogs.length > 0 || posts.length > 0) && (
    <>
      <div class="section-title">기술 블로그 최근 기록 <a href={blogUrl()}>전체 보기</a></div>
      <EntryList posts={posts.slice(0, 3)} devlogs={devlogs.slice(0, 3)} projectTitles={projectTitles} />
    </>
  )}
</BaseLayout>

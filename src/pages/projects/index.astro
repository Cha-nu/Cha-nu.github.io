---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/posts';
const projects = await getProjects();
---
<BaseLayout title="프로젝트" description="직접 만든 게임과 도구" section="portfolio">
  <section class="hero"><h1>프로젝트</h1><p>직접 만든 게임과 도구, 그리고 만들면서 남긴 기록</p></section>
  {projects.length ? <div class="project-grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    : <p class="empty">프로젝트를 정리하고 있습니다.</p>}
</BaseLayout>

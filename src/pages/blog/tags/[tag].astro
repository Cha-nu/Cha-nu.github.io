---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryList from '../../../components/EntryList.astro';
import { getAllTags, getPosts, getDevlogs, getProjects, tagSlug } from '../../../lib/posts';
export async function getStaticPaths() {
  return (await getAllTags()).map((t) => ({ params: { tag: t.slug }, props: { name: t.name } }));
}
const { tag } = Astro.params;
const { name } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.tags.some((t) => tagSlug(t) === tag));
const devlogs = (await getDevlogs()).filter((d) => d.data.tags.some((t) => tagSlug(t) === tag));
const projectTitles = Object.fromEntries((await getProjects()).map((p) => [p.id, p.data.title]));
---
<BaseLayout title={`#${name}`}>
  <section class="hero"><h1>#{name}</h1><p>{posts.length + devlogs.length}개의 기록</p></section>
  <EntryList posts={posts} devlogs={devlogs} projectTitles={projectTitles} />
</BaseLayout>

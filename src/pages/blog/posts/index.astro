---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryList from '../../../components/EntryList.astro';
import { CATEGORIES, type CategoryKey } from '../../../consts';
import { getPosts, categoryUrl } from '../../../lib/posts';
const posts = await getPosts();
const counts = Object.fromEntries(Object.keys(CATEGORIES).map((k) => [k, posts.filter((p) => p.data.category === k).length]));
---
<BaseLayout title="글" description="게임 수학, 물리, 알고리즘, 언리얼, CS 지식">
  <section class="hero"><h1>글</h1><p>분야별 지식 글 {posts.length}편</p></section>
  <nav class="chips">
    {(Object.keys(CATEGORIES) as CategoryKey[]).map((k) => (
      <a class="chip" href={categoryUrl(k)}>{CATEGORIES[k].title} <span>{counts[k]}</span></a>
    ))}
  </nav>
  <EntryList posts={posts} />
</BaseLayout>

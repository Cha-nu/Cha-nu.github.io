---
import { render } from 'astro:content';
import DevlogLayout from '../../layouts/DevlogLayout.astro';
import { getDevlogs } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getDevlogs()).map((devlog) => ({ params: { slug: devlog.id }, props: { devlog } }));
}
const { devlog } = Astro.props;
const { Content, headings } = await render(devlog);
---
<DevlogLayout devlog={devlog} headings={headings}><Content /></DevlogLayout>

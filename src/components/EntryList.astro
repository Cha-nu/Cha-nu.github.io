---
import { postUrl, devlogUrl, formatDate, categoryTitle, categoryUrl, type Post, type Devlog } from '../lib/posts';
interface Props { posts?: Post[]; devlogs?: Devlog[]; showCategory?: boolean; projectTitles?: Record<string, string> }
const { posts = [], devlogs = [], showCategory = true, projectTitles = {} } = Astro.props;
type Row = { href: string; title: string; desc: string; date: Date; badge?: string; badgeHref?: string };
const rows: Row[] = [
  ...posts.map((p) => ({
    href: postUrl(p), title: p.data.title, desc: p.data.description, date: p.data.pubDate,
    badge: showCategory ? categoryTitle(p.data.category) : undefined,
    badgeHref: showCategory ? categoryUrl(p.data.category) : undefined,
  })),
  ...devlogs.map((d) => ({
    href: devlogUrl(d), title: d.data.title, desc: d.data.description, date: d.data.pubDate,
    badge: `개발일지${projectTitles[d.data.project.id] ? ' · ' + projectTitles[d.data.project.id] : ''}`,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<ul class="post-list">
  {rows.map((r) => (
    <li>
      {r.badge && (r.badgeHref ? <a class="badge" href={r.badgeHref}>{r.badge}</a> : <span class="badge">{r.badge}</span>)}
      <a class="title" href={r.href}>{r.title}</a>
      <div class="desc">{r.desc}</div>
      <div class="meta">{formatDate(r.date)}</div>
    </li>
  ))}
</ul>

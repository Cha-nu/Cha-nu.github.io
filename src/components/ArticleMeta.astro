---
import { formatDate, readingMinutes, tagUrl } from '../lib/posts';
interface Props { pubDate: Date; updatedDate?: Date; body?: string; tags: string[] }
const { pubDate, updatedDate, body, tags } = Astro.props;
---
<div class="meta">
  <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
  {updatedDate && <span>{` · 수정 ${formatDate(updatedDate)}`}</span>}
  <span>{` · 약 ${readingMinutes(body)}분`}</span>
  {tags.length > 0 && <span class="tags">{' · '}{tags.map((t) => <a href={tagUrl(t)}>#{t}</a>)}</span>}
</div>

---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const toc = Astro.props.headings.filter((h) => h.depth === 2);
---
{toc.length > 2 && (
  <details class="toc" open>
    <summary>목차</summary>
    <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </details>
)}

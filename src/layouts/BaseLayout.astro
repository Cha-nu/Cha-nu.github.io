---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, PORTFOLIO_TITLE, PORTFOLIO_DESCRIPTION, AUTHOR, GITHUB_URL } from '../consts';
import { url, blogUrl } from '../lib/posts';

/** section: 'portfolio' = cha-nu.github.io/ , 'blog' = cha-nu.github.io/blog/ */
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; section?: 'portfolio' | 'blog' }
const { title, description, image, type = 'website', section = 'blog' } = Astro.props;
const isBlog = section === 'blog';
const siteName = isBlog ? SITE_TITLE : PORTFOLIO_TITLE;
const desc = description ?? (isBlog ? SITE_DESCRIPTION : PORTFOLIO_DESCRIPTION);
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? (/^https?:/.test(image) ? image : new URL(url(image), Astro.site).toString()) : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={blogUrl('rss.xml')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class={isBlog ? 'is-blog' : 'is-portfolio'}>
    <header class="site-header">
      <div class="wrap">
        {isBlog
          ? <a class="brand" href={blogUrl()}>{SITE_TITLE}</a>
          : <a class="brand" href={url()}>{PORTFOLIO_TITLE}<span class="brand-sub">portfolio</span></a>}
        <nav class="nav">
          {isBlog ? (
            <>
              <a href={blogUrl('devlog/')}>개발일지</a>
              <a href={blogUrl('posts/')}>글</a>
              <a href={blogUrl('tags/')}>태그</a>
              <a class="nav-switch" href={url()}>포트폴리오</a>
            </>
          ) : (
            <>
              <a href={url('projects/')}>프로젝트</a>
              <a class="nav-switch" href={blogUrl()}>기술 블로그</a>
              {GITHUB_URL && <a href={GITHUB_URL}>GitHub</a>}
            </>
          )}
          <button class="theme-btn" type="button" id="theme-btn" aria-label="다크 모드 전환">테마</button>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        © {year} {AUTHOR}
        {' · '}<a href={url()}>포트폴리오</a>
        {' · '}<a href={blogUrl()}>기술 블로그</a>
        {' · '}<a href={blogUrl('rss.xml')}>RSS</a>
        {GITHUB_URL && <>{' · '}<a href={GITHUB_URL}>GitHub</a></>}
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
      // 본문 그림을 누르면 원본 크기로 새 탭에서 연다
      document.querySelectorAll('.prose img').forEach((img) => {
        img.addEventListener('click', () => window.open(img.currentSrc || img.src, '_blank', 'noopener'));
      });
    </script>
  </body>
</html>

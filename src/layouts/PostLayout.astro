---
import BaseLayout from './BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Toc from '../components/Toc.astro';
import { SERIES } from '../consts';
import { getSeriesPosts, postUrl, seriesUrl, categoryUrl, categoryTitle, projectUrl, type Post } from '../lib/posts';
import { getEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props { post: Post; headings: MarkdownHeading[] }
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, series, seriesOrder, cover, tags, category } = post.data;
const project = post.data.project ? await getEntry(post.data.project) : undefined;

const seriesInfo = series ? SERIES[series] : undefined;
const seriesPosts = series ? await getSeriesPosts(series) : [];
const idx = seriesPosts.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? seriesPosts[idx - 1] : undefined;
const next = idx >= 0 && idx < seriesPosts.length - 1 ? seriesPosts[idx + 1] : undefined;
---
<BaseLayout title={title} description={description} image={cover} type="article">
  <article>
    <header class="post-head">
      <a class="badge" href={categoryUrl(category)}>{categoryTitle(category)}</a>
      {seriesInfo && series && <a class="badge muted" href={seriesUrl(series)}>{seriesInfo.title} · {seriesOrder}편</a>}
      <h1>{title}</h1>
      <ArticleMeta pubDate={pubDate} updatedDate={updatedDate} body={post.body} tags={tags} />
    </header>

    {seriesInfo && seriesPosts.length > 1 && (
      <nav class="series-box" aria-label="시리즈 목차">
        <strong><a href={seriesUrl(series!)}>{seriesInfo.title}</a> 시리즈</strong>
        <ol>
          {seriesPosts.map((p) => (
            <li class={p.id === post.id ? 'current' : undefined}>
              {p.id === post.id ? p.data.title : <a href={postUrl(p)}>{p.data.title}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {project && <p class="related">관련 프로젝트: <a href={projectUrl(project)}>{project.data.title}</a></p>}

    <Toc headings={headings} />
    <div class="prose"><slot /></div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="이전·다음 글">
        {prev && <a class="prev" href={postUrl(prev)}><small>← 이전 편</small>{prev.data.title}</a>}
        {next && <a class="next" href={postUrl(next)}><small>다음 편 →</small>{next.data.title}</a>}
      </nav>
    )}
  </article>
</BaseLayout>
